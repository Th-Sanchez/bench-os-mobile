# BenchOS Backend API base URL
# Android Emulator: http://10.0.2.2:8080
# iOS Simulator / Web: http://localhost:8080
# Physical Device on same Wi-Fi: http://<YOUR_LOCAL_IP>:8080
# Production: https://api.benchos.app.br
EXPO_PUBLIC_API_URL=http://localhost:8080

# Observability (Sentry — optional in local dev, recommended in EAS preview/production)
# Create a free React Native project at https://sentry.io and paste its DSN below
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
# Set to "true" only when testing Sentry event delivery locally in __DEV__
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=false
