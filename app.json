{
  "expo": {
    "name": "BenchOS",
    "slug": "bench-os",
    "version": "1.6.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "benchos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benchos.mobile"
    },
    "android": {
      "package": "com.benchos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BenchOS precisa da câmera para fotografar os aparelhos na bancada.",
          "photosPermission": "BenchOS precisa acessar suas fotos para anexar imagens às Ordens de Serviço.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "benchos-alerts"
        }
      ],
      "./plugins/withGoogleServicesEnv",
      [
        "./plugins/withSentrySafeUpload",
        {
          "url": "https://sentry.io/",
          "organization": "benchos-xi",
          "project": "benchos-mobile"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "BenchOS precisa acessar seus contatos para importar nome e telefone dos clientes mais rápido."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BenchOS precisa da câmera para ler o QR Code das etiquetas de aparelhos na bancada.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "54bc65dc-4ca3-44f1-aac2-04efc02f9f6f"
      }
    }
  }
}
